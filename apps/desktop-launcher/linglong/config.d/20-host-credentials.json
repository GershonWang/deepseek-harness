{
  "mounts": [
    {
      "type": "bind",
      "source": "/home/<USER>/.git-credentials",
      "destination": "/home/<USER>/.git-credentials",
      "options": ["ro", "bind"]
    },
    {
      "type": "bind",
      "source": "/home/<USER>/.ssh",
      "destination": "/home/<USER>/.ssh",
      "options": ["ro", "bind"]
    }
  ]
}
